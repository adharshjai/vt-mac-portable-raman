    "        mix=r*da[rng_mix.randint(len(da))]+(1-r)*db[rng_mix.randint(len(db))]\n",
    "        lb=np.zeros(NUM_CLASSES,dtype=np.float32); lb[cid_a]=1.0; lb[cid_b]=1.0\n",
