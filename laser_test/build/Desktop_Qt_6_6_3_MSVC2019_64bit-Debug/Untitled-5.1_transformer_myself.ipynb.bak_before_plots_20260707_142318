    "\n",
    "n_synth=0\n",
    "# Binary\n",
    "for cid_a,cid_b in combinations(range(NUM_CLASSES),2):\n",
    "    da,db=pure_data_raw[id_to_class[cid_a]],pure_data_raw[id_to_class[cid_b]]\n",
