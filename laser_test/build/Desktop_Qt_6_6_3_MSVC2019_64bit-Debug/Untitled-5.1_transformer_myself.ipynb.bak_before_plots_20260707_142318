    "\n",
    "\n",
    "# =========================================================\n",
    "# DATASET\n",
    "# =========================================================\n",
    "def augment_spectrum_1d(x):\n",
    "    x=x.copy()*np.float32(np.random.uniform(AUG_SCALE_LOW,AUG_SCALE_HIGH))\n",
