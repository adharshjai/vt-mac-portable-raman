    "\n",
    "\n",
    "# =========================================================\n",
    "# STEP 2: Split\n",
    "# =========================================================\n",
    "all_idx=list(range(X_all.shape[0]))\n",
    "rng_s=random.Random(SEED); rng_s.shuffle(all_idx)\n",
    "n_tr=int(len(all_idx)*TRAIN_RATIO); n_va=int(len(all_idx)*VAL_RATIO)\n",
