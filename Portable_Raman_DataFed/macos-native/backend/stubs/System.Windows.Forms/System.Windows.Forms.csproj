<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal stand-in for the .NET Framework 2.0 System.Windows.Forms that wrrusb2a.dll references.
       It carries the same assembly identity (name, version 2.0.0.0, ECMA public key token) so the
       runtime binds the reference; the members are no-op stand-ins since no window is ever shown. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <PublicSign>true</PublicSign>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ecma.pub</AssemblyOriginatorKeyFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0108;CS0114;CS8981</NoWarn>
  </PropertyGroup>
</Project>
